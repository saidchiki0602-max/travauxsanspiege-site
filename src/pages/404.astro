---
import Base from '../layouts/Base.astro';
import { L } from '../lib/links';
const here = Astro.url.pathname;
---
<Base title="Page introuvable — Travaux Sans Piège" description="Cette page n'existe pas ou a été déplacée." path="/404/" noindex>
  <div class="wrap legal"><h1>Page introuvable</h1><p>Cette page n'existe pas ou a été déplacée.</p><p><a class="btn p" href={L('/', here)}>Retour à l'accueil</a> <a class="btn s" href={L('/verifier-un-devis/', here)}>Vérifier un devis</a></p></div>
</Base>
